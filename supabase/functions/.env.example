# Arquivo exclusivamente de desenvolvimento local das Edge Functions.
# Produção: configurar segredos no Supabase. Nunca copiar para VITE_*.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são fornecidos no ambiente hospedado.
APP_ORIGIN=
INTAKE_ENABLED=false
# Segredo aleatório exclusivo com pelo menos 32 caracteres; nunca VITE_*.
INTAKE_HASH_SECRET=
INFINITEPAY_HANDLE=matheus-moraes-tsd
# Fase 4: habilitar após aplicar o SQL, publicar funções e conferir a conta.
INFINITEPAY_ENABLED=false
# Origem HTTPS do portal, sem caminho; usada no retorno público do comprador.
PUBLIC_APP_URL=
# Opcional; permite options.single_payment=true. Somente no backend.
INFINITEPAY_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
LLM_API_KEY=
DATAJUD_API_KEY=
# Secret Turnstile correspondente à VITE_TURNSTILE_SITE_KEY do portal:
TURNSTILE_SECRET_KEY=
